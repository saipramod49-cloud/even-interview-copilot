{
  "package_id": "com.saipramod.interviewcopilot",
  "edition": "202601",
  "name": "Interview Copilot",
  "version": "0.2.0",
  "min_app_version": "2.2.9",
  "min_sdk_version": "0.0.14",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "g2-microphone",
      "desc": "Continuously transcribe an interview while the session is active."
    },
    {
      "name": "network",
      "desc": "Connect to the speech and language model endpoints selected by the user.",
      "whitelist": [
        "http://localhost:11434",
        "http://127.0.0.1:11434",
        "http://localhost:8000",
        "http://127.0.0.1:8000",
        "https://api.openai.com"
        ,"https://even-interview-copilot.onrender.com"
      ]
    }
  ],
  "supported_languages": ["en"]
}
